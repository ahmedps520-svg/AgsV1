# ---------------------------------------------------------------------------
# Map Dismissals — environment variables
# Copy to `.env.local` for local development, or set them in your host
# (Vercel / Render) dashboard for production.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "publishable" / anon key. Safe to expose to the browser: every
# request it makes is still filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used exclusively for administrator account provisioning (creating staff and
# parent logins) in src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used to build magic-link / password-reset redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
