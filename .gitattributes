# The built site is published from the root of main (GitHub Pages "Deploy from
# a branch"). These files are regenerated by .github/workflows/deploy-pages.yml
# on every push — collapse them in diffs and keep them out of language stats.
_next/**           linguist-generated=true -diff
*.html             linguist-generated=true
index.txt          linguist-generated=true
__next.*.txt       linguist-generated=true
**/index.txt       linguist-generated=true
manifest.webmanifest linguist-generated=true
sw.js              linguist-generated=true
.published         linguist-generated=true
