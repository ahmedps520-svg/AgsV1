# ---------------------------------------------------------------------------
# AGS Dismissals — environment variables
#
# Leave everything empty to run the built-in demo (an in-browser school).
# Fill in the two Supabase values to connect a real school.
#
# Everything here is public and inlined into the static bundle at build time.
# The anon key is designed for browsers: every request it makes is filtered by
# Row Level Security. NEVER put a service-role key in this file.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (Project Settings → API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sub-path the site is served from. GitHub Pages project sites use the
# repository name; leave empty for local development or a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Public origin + base path, used to build email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
